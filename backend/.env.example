# Hosting: use the same project and JWT_SECRET as the existing web backend.
# Set secrets in Render Environment, never in frontend/project.godot or Git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=change-me-to-a-long-random-string
PORT=8000
CORS_ORIGINS=*

# Online PvP keeps rooms in memory: run exactly ONE uvicorn worker (no --workers N)
# until room state and locking move to a shared store.
PVP_ACTIVE_GRACE_SECONDS=15
PVP_WAITING_GRACE_SECONDS=60
PVP_CLOSED_TTL_SECONDS=60
PVP_STALE_WAITING_SECONDS=600
PVP_QUEUE_TTL_SECONDS=90
