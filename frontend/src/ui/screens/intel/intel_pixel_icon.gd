func _blit(ox: int, oy: int, cell: int, rows: PackedStringArray, color: Color) -> void:
	var y: int = 0
	while y < rows.size():
		var row: String = rows[y]
		var x: int = 0
		while x < row.length():
			if row[x] != ".":
				draw_rect(Rect2(ox + x * cell, oy + y * cell, cell, cell), color)
			x += 1
		y += 1
