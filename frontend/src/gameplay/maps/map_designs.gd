static func get_layout(map_id: String) -> PackedStringArray:
	if not DESIGNS.has(map_id):
		push_error("MapDesigns: unknown map_id '%s'" % map_id)
		return PackedStringArray()
	var rows: Array = DESIGNS[map_id] as Array
	return PackedStringArray(rows)
